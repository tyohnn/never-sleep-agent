{
  "$schema_comment": "Copy to never-sleep.config.json. REQUIRED: notion.rootPageUrl or notion.rootPageId (user-provided Notion root).",
  "version": 0,
  "project": {
    "name": "example-repo",
    "baseBranch": "main"
  },
  "notion": {
    "rootPageUrl": "https://www.notion.so/REPLACE_OVERNIGHT_ROOT_PAGE",
    "rootPageId": null,
    "tasksDataSourceId": "REPLACE_ME",
    "documentsDataSourceId": "REPLACE_ME",
    "boardPageId": "REPLACE_ME",
    "leaseDefaultMinutes": 90,
    "comment": "rootPageUrl or rootPageId is required user input. All Tasks/Documents/BOARD live under this root."
  },
  "slack": {
    "outboxChannelId": "REPLACE_ME",
    "standingThreadTs": null,
    "inboxChannelId": null,
    "ownerUserIds": ["REPLACE_OWNER_SLACK_USER_ID"],
    "emojiGate": null,
    "emojiGateEnabled": false
  },
  "omd": {
    "softRequire": true,
    "projectJsonPath": ".omd/project.json"
  },
  "modes": {
    "heavyMaxOpenPrs": 1,
    "mergeWhenGreen": true
  },
  "steer": {
    "persistEveryOwnerReply": true,
    "defaultTaskPriority": "P0",
    "outranksAgentPlans": true
  },
  "roles": {
    "enabled": ["worker", "director", "researcher", "auditor"],
    "defaultRole": "worker",
    "comment": "Each Cursor Automation prompt must be configured/saved by the human in Cursor UI."
  },
  "research": {
    "topics": [],
    "youtubeApiKeyEnv": "YOUTUBE_API_KEY",
    "maxItemsPerSource": 8,
    "preferLanguages": ["en", "ko"]
  },
  "auditor": {
    "canFinalizeDecisions": false,
    "comment": "false = auditor only drafts Decision proposals for director/owner"
  },
  "mcp": {
    "required": ["notion", "slack", "supabase", "vercel"],
    "hardFailIfMissing": ["notion", "slack"],
    "comment": "Agents must use these MCPs for their domains. Notion+Slack are always critical path."
  },
  "skills": {
    "installScript": "templates/default-skills.sh",
    "bootstrapOnAdopt": true
  },
  "worker": {
    "requireSubagentsForDirectWork": true,
    "subagentModel": "cursor-grok-4.5-high-fast",
    "allowParentProductEdits": false
  }
}
